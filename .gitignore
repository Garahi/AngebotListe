*.keystore
*.jks
*.p12
*.pfx

# IDE / Tools
.idea/
.vscode/launch.json
*.swp
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Sensitive
appsettings.Development.json
secrets.json
*.local.config

# Logs
*.log
logs/

# Temp
*.tmp
*.bak
*.cache

# Fertige Setup-Dateien (gross, werden lokal erzeugt)
deploy/cikti/
