<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AngebotListe.Mobile.Views.ProduktListePage"
             Title="Produkte"
             BackgroundColor="#F5F5F5">

    <!-- Oben rechts: neues Produkt anlegen -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Neu" Clicked="OnNeuClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*" Padding="10">

        <SearchBar Grid.Row="0" x:Name="txtSuche" Placeholder="Suchen (Name, Kategorie, Art.-Nr.)..."
                   TextChanged="OnSucheChanged" Margin="0,0,0,4"/>

        <Label Grid.Row="1" x:Name="lblAnzahl" FontSize="11" TextColor="Gray" Margin="6,0,0,6"
               Text="Tippen = bearbeiten · nach links wischen = löschen"/>

        <RefreshView Grid.Row="2" x:Name="refreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="cvProdukte" SelectionMode="Single" SelectionChanged="OnProduktSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                        <ActivityIndicator x:Name="busy" IsRunning="True" Color="#2563EB"/>
                        <Label x:Name="lblLeer" Text="Produkte werden geladen…" HorizontalOptions="Center"
                               TextColor="Gray" FontSize="14"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="🗑 Löschen" BackgroundColor="#F44336"
                                               Invoked="OnSwipeDelete" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Background="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Margin="0,4" Padding="12">
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                            Background="#EEE" WidthRequest="72" HeightRequest="72">
                                        <Image Source="{Binding BildSource}" Aspect="AspectFill"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Beschreibung}" FontSize="11" TextColor="Gray"
                                               LineBreakMode="TailTruncation" MaxLines="2"/>
                                        <Label Text="{Binding Kategorie}" FontSize="10" TextColor="#1B5E20"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding PreisFormatted}"
                                           FontSize="16" FontAttributes="Bold" TextColor="#1B5E20"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
