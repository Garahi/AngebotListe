<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AngebotListe.Mobile.Views.ProduktListePage"
             Title="Produkte"
             BackgroundColor="#F5F5F5">

    <!-- Oben rechts: neues Produkt anlegen -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="＋ Neu" Clicked="OnNeuClicked"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="10">

        <SearchBar Grid.Row="0" x:Name="txtSuche" Placeholder="Suchen (Name, Kategorie, Art.-Nr.)..."
                   TextChanged="OnSucheChanged" Margin="0,0,0,4"/>

        <!-- Gut sichtbarer Knopf für neues Produkt -->
        <Border Grid.Row="1" Background="#2563EB" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                HeightRequest="48" Margin="0,2,0,6">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNeuClicked"/>
            </Border.GestureRecognizers>
            <Label Text="＋  Neues Produkt" FontSize="15" FontAttributes="Bold" TextColor="White"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <Label Grid.Row="2" x:Name="lblAnzahl" FontSize="11" TextColor="Gray" Margin="6,0,0,6"
               Text="✏️ = ändern · 🗑 = löschen"/>

        <RefreshView Grid.Row="3" x:Name="refreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="cvProdukte" SelectionMode="Single" SelectionChanged="OnProduktSelected">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                        <ActivityIndicator x:Name="busy" IsRunning="True" Color="#2563EB"/>
                        <Label x:Name="lblLeer" Text="Produkte werden geladen…" HorizontalOptions="Center"
                               TextColor="Gray" FontSize="14"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="🗑 Löschen" BackgroundColor="#F44336"
                                               Invoked="OnSwipeDelete" CommandParameter="{Binding .}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Background="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" Margin="0,4" Padding="12">
                                <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                            Background="#EEE" WidthRequest="72" HeightRequest="72">
                                        <Image Source="{Binding BildSource}" Aspect="AspectFill"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="#1C1B1F"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Beschreibung}" FontSize="11" TextColor="Gray"
                                               LineBreakMode="TailTruncation" MaxLines="2"/>
                                        <Label Text="{Binding Kategorie}" FontSize="10" TextColor="#1B5E20"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="8">
                                        <Label Text="{Binding PreisFormatted}" HorizontalOptions="End"
                                               FontSize="16" FontAttributes="Bold" TextColor="#1B5E20"/>
                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                            <!-- Ändern -->
                                            <Border Background="#E3F2FD" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                    WidthRequest="40" HeightRequest="36">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnAendernTapped" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="✏️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <!-- Löschen -->
                                            <Border Background="#FFEBEE" StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                                    WidthRequest="40" HeightRequest="36">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnLoeschenTapped" CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="🗑" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
