<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AngebotListe.Mobile.Views.LoginPage"
             Title="Login"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource M3Surface}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">

                <!-- Logo / Header -->
                <Border Background="{StaticResource M3PrimaryContainer}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 999" WidthRequest="100" HeightRequest="100"
                        HorizontalOptions="Center" Margin="0,40,0,16">
                    <Label Text="📋" FontSize="56" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <Label Text="AngebotListe" FontSize="32" FontAttributes="Bold"
                       TextColor="{StaticResource M3OnSurface}" HorizontalOptions="Center"/>
                <Label Text="Bitte melden Sie sich an" FontSize="14"
                       TextColor="{StaticResource M3OnSurfaceVariant}"
                       HorizontalOptions="Center" Margin="0,0,0,24"/>

                <!-- Username -->
                <Border Background="White" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Benutzername" FontSize="11"
                               TextColor="{StaticResource M3OnSurfaceVariant}"/>
                        <Entry x:Name="txtUsername" FontSize="16" Placeholder="z.B. admin"
                               TextColor="{StaticResource M3OnSurface}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Password -->
                <Border Background="White" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Passwort" FontSize="11"
                               TextColor="{StaticResource M3OnSurfaceVariant}"/>
                        <Entry x:Name="txtPassword" FontSize="16" IsPassword="True"
                               Placeholder="••••••" TextColor="{StaticResource M3OnSurface}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Status -->
                <Label x:Name="lblStatus" FontSize="13" TextColor="{StaticResource M3Error}"
                       HorizontalOptions="Center" IsVisible="False"/>

                <!-- Login Button (M3 Filled Pill) -->
                <Border Background="{StaticResource M3Primary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 999" HeightRequest="56" Margin="0,8,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*" Padding="24,0" HorizontalOptions="Center">
                        <Label Grid.Column="0" Text="🔓" FontSize="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Anmelden" Margin="10,0,0,0"
                               FontSize="16" FontAttributes="Bold" TextColor="White"
                               VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Loading -->
                <ActivityIndicator x:Name="loading" IsRunning="False" IsVisible="False"
                                   Color="{StaticResource M3Primary}" HeightRequest="30"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
